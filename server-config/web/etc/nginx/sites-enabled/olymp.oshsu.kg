# Shared university NAT: page views are not authentication attempts.
map $request_method $auth_network_key {
    default "";
    POST $binary_remote_addr;
}
map "$request_method:$cookie_csrftoken" $auth_client_key {
    default "";
    "~^POST:[a-zA-Z0-9]{32,64}$" "$binary_remote_addr:$cookie_csrftoken";
}
limit_req_zone $auth_network_key zone=auth_network:10m rate=10r/s;
limit_req_zone $auth_client_key zone=auth_client:10m rate=30r/m;

server {
    server_name olymp.oshsu.kg www.olymp.oshsu.kg _;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 64M;
    server_tokens off;

    error_page 502 503 504 /busy.html;
    location = /busy.html {
        root /var/www/olymp.oshsu.kg/static;
        internal;
    }

    # The token for the runner is issued by the site itself (dmoj/urls.py), not by the runner.
    location = /runner/token/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /runner/ {
        proxy_pass http://10.10.8.227:9910/;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        client_max_body_size 2M;
    }
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /static/ {
        alias /var/www/olymp.oshsu.kg/static/;
        expires 30d;
        access_log off;
    }

    location /media/ {
        alias /var/www/olymp.oshsu.kg/media/;
        expires 7d;
        add_header Content-Security-Policy "sandbox" always;
        add_header X-Content-Type-Options nosniff always;
        access_log off;
    }

    location /event/ {
        proxy_pass http://127.0.0.1:9996/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 24h;
    }

    location /channels/ {
        proxy_pass http://127.0.0.1:15100;
        proxy_set_header Host $host;
    }

    location ~ ^/(accounts/login|accounts/register)/ {
        limit_req zone=auth_network burst=200 nodelay;
        limit_req zone=auth_client burst=10 nodelay;
        limit_req_status 429;
        error_page 429 = @auth_busy;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location @auth_busy {
        default_type text/html;
        add_header Retry-After 30 always;
        add_header Cache-Control no-store always;
        return 429 '<!doctype html><html lang="ru"><meta charset="utf-8"><title>Повторите попытку</title><h1>Слишком много попыток</h1><p>Подождите 30 секунд и отправьте форму снова.</p></html>';
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/olymp.oshsu.kg/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/olymp.oshsu.kg/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot



}


server {
    if ($host = www.olymp.oshsu.kg) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = olymp.oshsu.kg) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80 default_server;
    listen [::]:80 default_server;
    server_name olymp.oshsu.kg www.olymp.oshsu.kg _;
    return 404; # managed by Certbot




}