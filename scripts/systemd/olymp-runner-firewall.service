# On judge.oshsu.kg: the code runner port 9910 accepts connections only from the web server.
[Unit]
Description=OshSU Olymp: allow code runner port 9910 only from the web server
After=network-pre.target
Before=olymp-runner.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -C INPUT -p tcp --dport 9910 -s 10.10.8.226 -j ACCEPT 2>/dev/null || iptables -I INPUT 1 -p tcp --dport 9910 -s 10.10.8.226 -j ACCEPT; iptables -C INPUT -p tcp --dport 9910 -j DROP 2>/dev/null || iptables -I INPUT 2 -p tcp --dport 9910 -j DROP'
ExecStop=/bin/sh -c 'iptables -D INPUT -p tcp --dport 9910 -j DROP; iptables -D INPUT -p tcp --dport 9910 -s 10.10.8.226 -j ACCEPT'

[Install]
WantedBy=multi-user.target
