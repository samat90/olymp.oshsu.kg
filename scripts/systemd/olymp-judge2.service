[Unit]
Description=OshSU Olymp Judge 2
After=network.target

[Service]
User=admin
Group=admin
WorkingDirectory=/home/admin/judge-server
ExecStart=/home/admin/judge-server/venv/bin/dmoj -c /home/admin/judge-config/judge2.yml -p 9999 --skip-self-test 10.10.8.226
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
