# On olymp.oshsu.kg: the judge bridge port 9999 accepts connections only from judge.oshsu.kg.
[Unit]
Description=OshSU Olymp: allow judge bridge port 9999 only from judge server
After=network-pre.target
Before=olymp-bridge.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -C INPUT -p tcp --dport 9999 -s 10.10.8.227 -j ACCEPT 2>/dev/null || iptables -I INPUT 1 -p tcp --dport 9999 -s 10.10.8.227 -j ACCEPT; iptables -C INPUT -p tcp --dport 9999 -j DROP 2>/dev/null || iptables -I INPUT 2 -p tcp --dport 9999 -j DROP'
ExecStop=/bin/sh -c 'iptables -D INPUT -p tcp --dport 9999 -j DROP; iptables -D INPUT -p tcp --dport 9999 -s 10.10.8.227 -j ACCEPT'

[Install]
WantedBy=multi-user.target
