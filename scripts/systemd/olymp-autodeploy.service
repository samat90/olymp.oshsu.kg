# Deploys new signed commits from GitHub main (scripts/server/autodeploy.sh).
[Unit]
Description=OshSU Olymp auto-deploy from GitHub
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=admin
ExecStart=/bin/bash -c 'bash /var/www/olymp.oshsu.kg/scripts/server/autodeploy.sh >> /var/log/olymp/deploy.log 2>&1'
# A slow download from GitHub (up to 2 h, see autodeploy.sh) plus the deploy itself.
TimeoutStartSec=4h
