# Production environment for olymp.oshsu.kg
# Copy to .env (gitignored) on the server and fill in real values.

# === Django ===
DMOJ_SECRET_KEY=REPLACE_WITH_50_CHARS_RANDOM_STRING

# === PostgreSQL ===
DMOJ_DB_ENGINE=postgresql
DMOJ_DB_HOST=localhost
DMOJ_DB_PORT=5432
DMOJ_DB_NAME=olymp_oshsu
DMOJ_DB_USER=olymp
DMOJ_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# === Redis (cache + celery) ===
DMOJ_REDIS_URL=redis://localhost:6379/1
DMOJ_CELERY_BROKER=redis://localhost:6379/2

# === SMTP ===
DMOJ_SMTP_HOST=smtp.yandex.ru
DMOJ_SMTP_PORT=465
DMOJ_SMTP_USER=noreply@oshsu.kg
DMOJ_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
