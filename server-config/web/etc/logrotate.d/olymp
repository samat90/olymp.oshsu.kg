# Logs of olymp.oshsu.kg (gunicorn, deploy, health). Installed from git by scripts/server/sync_system.sh.
/var/log/olymp/*.log {
    weekly
    rotate 8
    maxsize 100M
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    su admin admin
}
# The daily backup writes here as root.
/var/log/olymp-backup.log {
    monthly
    rotate 6
    compress
    missingok
    notifempty
}
